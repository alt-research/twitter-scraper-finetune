{
  "name": "twitter-scraper-api",
  "version": "1.0.0",
  "main": "api/server.js",
  "type": "module",
  "scripts": {
    "start": "node api/server.js",
    "start:with-migrations": "npm run migrations:run && npm start",
    "dev": "nodemon api/server.js",
    "dev:with-migrations": "npm run migrations:run && npm run dev",
    "dev:setup": "bash scripts/dev-setup.sh",
    "dev:services": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:services:stop": "docker-compose -f docker-compose.dev.yml down",
    "migrations:run": "node api/database/migrations/runMigrations.js",
    "migrations:generate": "typeorm-ts-node-esm migration:generate -d api/database/typeorm.config.js",
    "init-db": "npm run migrations:run",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:maintenance": "bash scripts/db-maintenance.sh",
    "db:scheduled-backup": "bash scripts/scheduled-backups.sh",
    "generate-virtuals": "node src/virtuals/GenerateCharacter.js",
    "twitter": "node src/twitter/index.js",
    "twitter:db": "node src/scripts/scrape-to-db.js",
    "blog": "node src/blog/blogScrape.js",
    "character": "node src/character/GenerateCharacter.js",
    "finetune": "node ./scripts/finetune.js",
    "finetune:test": "node ./scripts/finetune.js --test"
  },
  "keywords": [
    "twitter",
    "scraper",
    "api",
    "fastify",
    "redis",
    "bullmq",
    "microservice",
    "postgres",
    "typeorm"
  ],
  "author": "dreaminglucid",
  "license": "MIT",
  "description": "Twitter scraper microservice API built with Fastify and PostgreSQL",
  "dependencies": {
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "agent-twitter-client": "^0.0.13",
    "axios": "^1.7.7",
    "bullmq": "^4.13.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "cli-table3": "^0.6.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.24.3",
    "fastify-cors": "^6.1.0",
    "fastify-plugin": "^4.5.1",
    "fs": "^0.0.1-security",
    "inquirer": "^12.0.1",
    "ioredis": "^5.3.2",
    "openai": "^4.73.1",
    "ora": "^8.1.0",
    "pg": "^8.11.3",
    "pino-pretty": "^10.2.3",
    "progress": "^2.0.3",
    "puppeteer-cluster": "^0.24.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^4.6.10",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "ua-parser-js": "^2.0.0-rc.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alt-research/twitter-scraper-finetune.git"
  },
  "bugs": {
    "url": "https://github.com/alt-research/twitter-scraper-finetune/issues"
  },
  "homepage": "https://github.com/alt-research/twitter-scraper-finetune#readme"
}
