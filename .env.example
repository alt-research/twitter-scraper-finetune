# API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
KEEP_CONNECTION_OPEN=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=twitter_scraper
# Set to 'false' to disable SSL for PostgreSQL in Docker environments that don't support it
POSTGRES_SSL=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Twitter Credentials
TWITTER_USERNAME=your_username
TWITTER_PASSWORD=your_password
TWITTER_EMAIL=your_email

# Twitter Scraper Settings
MAX_TWEETS=50000
MAX_RETRIES=5
RETRY_DELAY=5000
MIN_DELAY=1000
MAX_DELAY=3000
RATE_LIMIT_THRESHOLD=3

# Timeout Settings
COLLECTION_GLOBAL_TIMEOUT=120000     # Global timeout for entire collection (ms) - 2 minutes
COLLECTION_STALL_TIMEOUT=15000      # Time without progress before marking as stalled (ms)
COLLECTION_PROGRESS_CHECK=2000      # How often to check collection progress (ms)
JOB_STALL_TIMEOUT=45000             # Time without progress in a job before marking as stalled (ms)
JOB_PROGRESS_CHECK=5000             # How often to check job progress (ms)
FORCED_BREAK_TIMEOUT=120000         # Max time to wait for breaking out of a stalled collection loop (ms)

# Rate Limit Settings
RATE_LIMIT_BASE_DELAY=60000         # Base delay for rate limit backoff (ms)
RATE_LIMIT_MAX_DELAY=900000         # Maximum delay for rate limit backoff (ms)
RATE_LIMIT_DURATION=900000          # How long to mark a user as rate limited (ms)
RATE_LIMIT_KEY_EXPIRY=900           # Redis key expiry for rate limit flags (seconds)

# Redis Key Settings
NON_RETRIABLE_KEY_EXPIRY=86400      # Redis key expiry for non-retriable flags (seconds)
PROGRESS_KEY_EXPIRY=3600            # Redis key expiry for progress tracking (seconds)

# Logging Configuration
LOG_LEVEL=info                      # Logging level: trace, debug, info, warn, error, fatal
LOG_DIR=logs                        # Directory to store log files
LOG_TO_FILE=true                    # Whether to write logs to files
DEBUG=false                         # Enable debug output in the console

# (Optional) Blog Configuration
BLOG_URLS_FILE=                     # Path to file containing blog URLs