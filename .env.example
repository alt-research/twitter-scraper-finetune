# API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
KEEP_CONNECTION_OPEN=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=twitter_scraper
# Set to 'false' to disable SSL for PostgreSQL in Docker environments that don't support it
POSTGRES_SSL=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Twitter Credentials
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# Twitter Scraper Configuration
MAX_TWEETS=50000
MAX_RETRIES=5
RETRY_DELAY=5000
MIN_DELAY=1000
MAX_DELAY=3000
# Rate Limit Prevention
RATE_LIMIT_THRESHOLD=3  # Number of rate limits before switching to fallback method

# Proxy Configuration (helps prevent rate limiting)
PROXY_ENABLED=false
PROXY_SERVER=               # Format: http://proxy-server.com:8080 or socks5://proxy-server.com:1080
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ROTATION_INTERVAL=600 # Time in seconds between proxy rotations (0 = no rotation)
PROXY_POOL=                 # Comma-separated list of proxy servers for rotation

# Debug
DEBUG=false

# (Optional) Blog Configuration
BLOG_URLS_FILE= # path to file containing blog URLs