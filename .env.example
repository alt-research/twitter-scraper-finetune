# API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
KEEP_CONNECTION_OPEN=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=twitter_scraper
DB_URL=postgres://postgres:postgres@localhost:5432/twitter_scraper

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Twitter Credentials (Optional - can also be provided via API)
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# Twitter Scraper Configuration
MAX_TWEETS=50000
MAX_RETRIES=5
RETRY_DELAY=5000
MIN_DELAY=1000
MAX_DELAY=3000

# Debug
DEBUG=false

# (Optional) Blog Configuration
BLOG_URLS_FILE= # path to file containing blog URLs