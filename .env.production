# API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
KEEP_CONNECTION_OPEN=true

# Database Configuration - Using Docker service names
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=twitter_scraper
# Set to 'false' to disable SSL for PostgreSQL in Docker environments that don't support it
POSTGRES_SSL=false

# Redis Configuration - Using Docker service name
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Twitter Credentials
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# Twitter Scraper Configuration
MAX_TWEETS=1000
MAX_RETRIES=3
RETRY_DELAY=5000
MIN_DELAY=1000
MAX_DELAY=3000

# Debug
DEBUG=false

# (Optional) Blog Configuration
BLOG_URLS_FILE= # path to file containing blog URLs
